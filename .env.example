# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=sdu_alumni_db
MYSQL_USER=sdu_alumni
MYSQL_PASSWORD=change-me
MYSQL_HOST_PORT=3307

# MinIO
# Silo 是维护中的 MinIO 兼容分支；如需使用已缓存的旧镜像，可覆盖此值。
MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# 构建源
# 镜像构建需要访问 Alpine apk、Go module 代理和 npm registry。
# 国内服务器建议改用镜像站；CI 不读取 .env，始终使用 Dockerfile 里的官方默认值。
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
# Alpine apk 源主机名替换；留空表示使用官方 dl-cdn.alpinelinux.org
APK_MIRROR=mirrors.aliyun.com

# Redis
REDIS_PASSWORD=
REDIS_HOST_PORT=6379

# Rate limit
RATE_LIMIT_ENABLED=false
RATE_LIMIT_GLOBAL_RPM=120
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_VERIFY_CODE_RPM=3
RATE_LIMIT_ADMIN_RPM=30

# CORS
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=

# Host ports
API_HOST_PORT=8080
WEB_HOST_PORT=80

# API proxy settings, comma-separated CIDR/IP list. Leave empty when serving directly.
SERVER_TRUSTED_PROXIES=

# SMS
SMS_ENABLED=false
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_REGION=ap-beijing
SMS_TENCENT_APP_ID=
SMS_TENCENT_SIGN_NAME=your-sign-name
SMS_TENCENT_TEMPLATE_ID=
SMS_TENCENT_ENDPOINT=sms.tencentcloudapi.com

# Email
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=your-name

# 在线接口文档（本地编排默认开启；公开部署设为 false）
SWAGGER_ENABLED=true
